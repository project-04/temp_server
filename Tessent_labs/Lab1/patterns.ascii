ASCII_PATTERN_FILE_VERSION = 3;


SETUP = 

    declare input bus "PI" = "/a", "/b", "/c", "/d", "/e";

    declare output bus "PO" = "/z";

end;

SCAN_TEST =

    pattern = 0;
    force   "PI" "00111" 0;
    measure "PO" "1" 1;

    pattern = 1;
    force   "PI" "11101" 0;
    measure "PO" "1" 1;

    pattern = 2;
    force   "PI" "11011" 0;
    measure "PO" "1" 1;

    pattern = 3;
    force   "PI" "01001" 0;
    measure "PO" "0" 1;

    pattern = 4;
    force   "PI" "01100" 0;
    measure "PO" "0" 1;

    pattern = 5;
    force   "PI" "10111" 0;
    measure "PO" "0" 1;

end;

