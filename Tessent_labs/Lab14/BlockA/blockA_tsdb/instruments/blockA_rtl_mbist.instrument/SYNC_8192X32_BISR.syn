`celldefine
module SYNC_8192X32_BISR (
    SCLK,
    RSTB,
    SDIN,
    SDOUT,
    CLK,
    WEB,
    BWEB,
    CEB,
    TSEL,
    A,
    D,
    Q

);
input           CLK;
input           WEB;
input  [31:0]   BWEB;
input           CEB;
input   [1:0]   TSEL;
input  [12:0]   A;
input  [31:0]   D;
output [31:0]   Q;
input SCLK;
input RSTB;
input SDIN;
output SDOUT;

endmodule
`endcelldefine
