#!/bin/sh
unset noclobber
xitval=0

if [ -f ./questa.setup_script ] ; then
  . ./questa.setup_script
fi

set -v

if [ ! -d questa.logical_libraries ] ; then mkdir questa.logical_libraries; fi


vlib ./questa.logical_libraries/dut_work
vmap work ./questa.logical_libraries/dut_work



# Entry 1
vlog -work work -mixedansiports +librescan -vlog01compat -ysearchlib \
      "../../blockA_tsdb/dft_inserted_designs/blockA_rtl.dft_inserted_design/modified_rtl_files/blockA.v" \
      -f questa.arguments_1
if [ $? != 0 ] ; then xitval=-1; echo "Failure on entry 1"; fi

# Entry 2
vlog -work work -mixedansiports +librescan -vlog01compat -ysearchlib \
      "../../blockA_tsdb/instruments/blockA_rtl_cells.instrument/blockA_rtl_tessent_posedge_synchronizer_reset.v" \
      -f questa.arguments_1
if [ $? != 0 ] ; then xitval=-1; echo "Failure on entry 2"; fi

# Entry 3
vlog -work work -mixedansiports +librescan -vlog01compat -ysearchlib \
      "../../blockA_tsdb/instruments/blockA_rtl_ijtag.instrument/blockA_rtl_tessent_sib_1.v" \
      "../../blockA_tsdb/instruments/blockA_rtl_ijtag.instrument/blockA_rtl_tessent_sib_2.v" \
      -f questa.arguments_1
if [ $? != 0 ] ; then xitval=-1; echo "Failure on entry 3"; fi

# Entry 4
vlog -work work -mixedansiports +librescan -vlog01compat -ysearchlib \
      "../../blockA_tsdb/instruments/blockA_rtl_mbist.instrument/blockA_rtl_tessent_mbist_bap.v" \
      "../../blockA_tsdb/instruments/blockA_rtl_mbist.instrument/blockA_rtl_tessent_mbist_c1_controller.v" \
      "../../blockA_tsdb/instruments/blockA_rtl_mbist.instrument/blockA_rtl_tessent_mbist_c1_interface_m1.v" \
      -f questa.arguments_1
if [ $? != 0 ] ; then xitval=-1; echo "Failure on entry 4"; fi

if [ $xitval -ne 0 ]; then
  echo "Compilation failed"
fi

exit $xitval
